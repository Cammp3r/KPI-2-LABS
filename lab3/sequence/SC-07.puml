@startuml
title SC-07. Правильне рішення отримує статус Accepted

actor "User" as User
boundary "Web UI" as UI
control "SubmissionController" as Controller
entity "SubmissionService" as SubmissionService
participant "Judge" as Judge
participant "CodeRunner" as Runner
participant "ResourceMonitor" as Metrics
database "Database" as DB

User -> UI: selectLanguage(language)
User -> UI: submitSolution(code, language, taskId)
activate UI
UI -> Controller: postSubmission(code, language, taskId, userId)
activate Controller

Controller -> SubmissionService: createPendingSubmission()
activate SubmissionService
SubmissionService -> DB: saveSubmission(status="Pending")
activate DB
DB --> SubmissionService: submissionId
deactivate DB
SubmissionService --> Controller: pendingSubmission(submissionId)
deactivate SubmissionService
Controller --> UI: submissionCreated(submissionId)
UI --> User: submissionQueued()
deactivate Controller
deactivate UI
Controller -> Judge: validateSubmission(submissionId)
activate Judge

loop Для кожного тест-кейсу
    Judge -> DB: loadNextTestCase(taskId)
    activate DB
    DB --> Judge: testCase
    deactivate DB
    Judge -> Runner: executeTestCase(code, testCase)
    activate Runner
    Runner -> Metrics: measure(runtime, memory)
    activate Metrics
    Metrics --> Runner: executionMetrics
    deactivate Metrics
    Runner --> Judge: testResult(executionMetrics)
    deactivate Runner
end

alt Усі тест-кейси пройдено
    Judge -> SubmissionService: markAsAccepted(submissionId)
    activate SubmissionService
    SubmissionService -> DB: updateStatus("Accepted")
    activate DB
    deactivate DB
    SubmissionService -> DB: saveMetrics(runtime, memory)
    activate DB
    deactivate DB
    SubmissionService -> DB: addToUserHistory(userId, submissionId)
    activate DB
    deactivate DB
    SubmissionService --> Controller: acceptedSubmission
    deactivate SubmissionService
    activate Controller
    Controller --> UI: displayResults("Accepted", runtime, memory)
    activate UI
    UI --> User: showAcceptedResult()
    UI --> User: resultDisplayed()
    deactivate UI
    deactivate Controller
else Тест не пройдено
    Judge -> SubmissionService: markAsRejected(submissionId)
    activate SubmissionService
    SubmissionService -> DB: updateStatus("Rejected")
    activate DB
    deactivate DB
    SubmissionService --> Controller: rejectedSubmission
    deactivate SubmissionService
    activate Controller
    Controller --> UI: displayResults("Rejected")
    activate UI
    UI --> User: showRejectedResult()
    UI --> User: resultDisplayed()
    deactivate UI
    deactivate Controller
end

deactivate Judge
@enduml
